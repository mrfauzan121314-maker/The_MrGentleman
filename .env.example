# Copy this file to .env and fill in thy key:
#
#     cp .env.example .env
#
# .env is ignored by git and must never be committed.
# Anything already exported in the shell takes precedence over this file.

# Thy key for an OpenAI-compatible API. OPENAI_API_KEY works as a fallback.
MRGENTLEMAN_API_KEY=

# Optional: another provider's OpenAI-compatible endpoint.
# MRGENTLEMAN_BASE_URL=https://api.openai.com/v1

# Optional: the model thou wouldst consult.
# MRGENTLEMAN_MODEL=gpt-4o-mini

# Optional: seconds to wait upon the oracle before giving up.
# MRGENTLEMAN_TIMEOUT=90
